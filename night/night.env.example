# Copy to night/night.env (gitignored) and fill in. Never bake these into the image.
REPO=__REPO__
# Fine-grained PAT scoped to this repo only: Contents RW, Pull requests RW.
GH_TOKEN=
# From `claude setup-token` (subscription) or use ANTHROPIC_API_KEY instead.
CLAUDE_CODE_OAUTH_TOKEN=
BEADHUB_PROJECT=__PROJECT__
# Confirm at the dry run which key lets a fresh container run `bdh :init` non-interactively.
BEADHUB_API_KEY=
NIGHT_HOURS=8
SESSION_TIMEOUT=45m
